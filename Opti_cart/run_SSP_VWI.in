&parameters_cube
nx = 128 ,
ny = 32 ,
nz = 64
x_max = 4.35, !* pi
y_max = 1.05 ,!* pi
z_max = 1. ,  
nb_cpu_y = 4 ,
nb_cpu_z = 8
/


&parameters_physical
Re = 1000. ,
Pr = 1. ,
Ri = 1e-4 ,
/


&parameters_timescheme
tmax = 20,
dt = 2E-4 ,
cfl = 0.5 ,
root_dir = 'data_fun/'
dn_dump = 1000,
resume = F,
explicit = F,
io_nrj = 'ex.dat'
/

&parameters_diagnostics
snap_dir = 'snapshots/'
dn_snap = 500,
/


