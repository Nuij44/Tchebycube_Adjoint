&parameters_cube
nx = 64 ,
ny = 64 ,
nz = 64 ,
x_max = 4.35, !* pi
y_max = 1.05 ,!* pi
z_max = 1. ,  
nb_cpu_y = 12 ,
nb_cpu_z = 8
/


&parameters_physical
Re = 1000. ,
Pr = 1. ,
Ri = 1e-2 ,
/


&parameters_timescheme
tmax = 10000 ,
dt = 1E-2 ,
cfl = 0.5 ,
root_dir = 'data_verif/'
dn_dump = 1000,
resume = F,
explicit = F,
io_nrj = 'ex.dat'
/

&parameters_diagnostics
snap_dir = 'snapshots/'
dn_snap = 500,
/



